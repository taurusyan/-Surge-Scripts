#!name=🐻 携程旅行 [签到·适配版]
#!desc=携程每日定时签到。扩大授权捕获范围，兼容携程域名变化。
#!system=ios
#!category=签到
#!arguments=定时签到:30 8 * * *,禁用授权脚本:,禁用MITM:
#!arguments-desc=定时签到：Cron 表达式，默认每日 8:30 执行。\n禁用授权脚本：授权获取成功后输入 # 可关闭授权捕获。\n禁用MITM：输入 # 可关闭本模块 MITM。

[Script]
携程旅行[签到] = type=cron,cronexp="{{{定时签到}}}",wake-system=1,script-update-interval=0,timeout=300,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js

携程旅行[授权] = type=http-response,pattern=^https:\/\/(?:[^\/]+\.)?(?:ctrip\.com|c-ctrip\.com)\/,requires-body=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/taurusyan/-Surge-Scripts/main/Ctrip-Auth-Adapter.js

[MITM]
hostname = %APPEND% *.ctrip.com, *.c-ctrip.com
