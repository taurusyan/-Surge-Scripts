#!name=🐻 携程旅行 [签到·适配版]
#!desc=携程每日自动签到，默认每天 08:30 执行，并自动捕获携程账号授权。
#!system=ios

[Script]
携程旅行[签到] = type=cron,cronexp="30 8 * * *",wake-system=1,script-update-interval=0,timeout=300,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js
携程旅行[授权] = type=http-response,pattern=^https:\/\/(?:[^\/]+\.)?(?:ctrip\.com|c-ctrip\.com)\/,requires-body=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/taurusyan/-Surge-Scripts/main/Ctrip-Auth-Adapter.js

[MITM]
hostname = %APPEND% *.ctrip.com, *.c-ctrip.com
